PORT=3000
NODE_ENV=development

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/productdb?schema=public"
REDIS_URL="redis://localhost:6379"
FRONTEND_URL="http://localhost:5173"
CACHE_TTL_SECONDS=60

# --- Authentication ---------------------------------------------------------
# 32+ characters, and ACCESS must differ from REFRESH.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-me-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-secret"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Set to `true` when the API is served over HTTPS.
COOKIE_SECURE=false
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
RATE_LIMIT_WINDOW_SECONDS=300

# --- E-mail (Nodemailer) ----------------------------------------------------
# Leave SMTP_HOST empty to print e-mails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Gmail: leave SMTP_HOST=smtp.gmail.com, then fill in your address and an
# App Password (https://myaccount.google.com/apppasswords, needs 2-Step
# Verification). The Docker stack reads these from the .env next to
# compose.yaml, not from this file.
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Product Monitor <no-reply@product-monitor.local>"

# Pepper for the HMAC that stores password-reset codes (optional: falls back
# to JWT_REFRESH_SECRET). Changing it invalidates codes that are in flight.
PASSWORD_RESET_PEPPER=

# --- Messaging --------------------------------------------------------------
KAFKA_BROKERS="localhost:9094"
KAFKA_TOPIC="product.events"
KAFKA_CONSUMER_GROUP="product-management-events"
KAFKA_AUTH_TOPIC="auth.events"
KAFKA_AUTH_CONSUMER_GROUP="product-management-auth"

RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_EXCHANGE="product.events"
RABBITMQ_QUEUE="product.notifications"
RABBITMQ_AUTH_EXCHANGE="auth.events"
RABBITMQ_AUTH_QUEUE="auth.notifications"
